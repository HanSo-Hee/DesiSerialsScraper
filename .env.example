# Environment Configuration

# Telegram API credentials (get from https://my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash_here

# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyZ

# Database Settings
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=serial_bot

# Telegram Channel Configuration
MAIN_CHANNEL_ID=-1001234567890
FILE_CHANNEL_ID=-1001234567891
HISTORY_CHANNEL_ID=-1001234567891
LOG_CHANNEL_ID=-1001234567892

# Admin User IDs (comma-separated integer Telegram User IDs)
ADMIN_IDS=123456789,987654321

# Force Subscription Channels (comma-separated integer Telegram Channel IDs)
FORCE_SUB_CHANNELS=-1001234567890

# Scraper Settings
SOURCE_URL=https://desiserials.com.co/
TARGET_DOMAINS=desiserials.com.co,www.desi-serials.to
SCRAPE_INTERVAL=300

# Lifecycle Settings
DELETE_AFTER_HOURS=12

# Storage & Media Settings
DOWNLOAD_DIR=downloads
DOWNLOAD_TIMEOUT=1800

# Concurrency Controls
MAX_CONCURRENT_DOWNLOADS=2
MAX_CONCURRENT_UPLOADS=1

CAPTION_TEMPLATE="📺 {show_name}\n\n🎬 Episode {episode_number}\n📅 {episode_date}\n\n━━━━━━━━━━━━━━━━━━\n\nUploader : @TellyFun_Official"

# Miscellaneous Settings
LOG_LEVEL=INFO
TIMEZONE=UTC
